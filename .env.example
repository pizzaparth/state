# ==============================================================================
# State (by Ksan Relay) — Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database. Neon hosts use Neon's WebSocket driver; localhost uses
# node-postgres, so a local Postgres works for development.
# Neon:  postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
# Local: postgresql://[os-user]@localhost:5432/state
# Production: use Neon's pooled host (ep-xxx-pooler...) so many serverless instances
# share a few Postgres connections.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/state?sslmode=require"
# Connections per server instance (default 10)
DATABASE_POOL_MAX=10

# Authentication (Better Auth)
# Generate a secure secret using: openssl rand -base64 32
# Production refuses to start with this example value or anything under 32 characters,
# and requires https:// for BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL (lib/env.ts).
BETTER_AUTH_SECRET="state_development_secret_key_minimum_32_characters_long_12345"
BETTER_AUTH_URL="http://localhost:3000"

# Social Authentication Providers (Optional in local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# India-First Billing (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Razorpay plan IDs (Dashboard → Subscriptions → Plans)
RAZORPAY_PLAN_INDIVIDUAL_MONTHLY=""
RAZORPAY_PLAN_INDIVIDUAL_YEARLY=""
RAZORPAY_PLAN_ORGANISATION_MONTHLY=""
RAZORPAY_PLAN_ORGANISATION_YEARLY=""

# International Billing (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe recurring price IDs (organisation prices are per seat)
STRIPE_PRICE_INDIVIDUAL_MONTHLY=""
STRIPE_PRICE_INDIVIDUAL_YEARLY=""
STRIPE_PRICE_ORGANISATION_MONTHLY=""
STRIPE_PRICE_ORGANISATION_YEARLY=""

# Production Monitoring & Error Tracking (Sentry)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
