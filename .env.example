# ==============================================================================
# State (by Ksan Relay) — Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Neon Serverless PostgreSQL recommended)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/state_db"

# Authentication (Better Auth)
# Generate a secure secret using: openssl rand -base64 32
BETTER_AUTH_SECRET="state_development_secret_key_minimum_32_characters_long_12345"
BETTER_AUTH_URL="http://localhost:3000"

# Social Authentication Providers (Optional in local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# India-First Billing (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# International Billing (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Production Monitoring & Error Tracking (Sentry)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
